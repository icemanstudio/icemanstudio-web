{
  "name": "icemanstudio-web",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/dl/*"]
  },
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "icemanstudio-files", "jurisdiction": "eu" }],
  "observability": { "enabled": true }
}
