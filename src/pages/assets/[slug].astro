---
import Base from '../../layouts/Base.astro';
import ProductPage from '../../components/ProductPage.astro';
import { products } from '../../data/products.js';
import { t as all } from '../../data/t.js';
export function getStaticPaths() { return products.map((p) => ({ params: { slug: p.slug }, props: { p } })); }
const { p } = Astro.props;
const t = all.en;
---
<Base t={t} title={p.name} path={`/assets/${p.slug}/`}>
  <ProductPage p={p} t={t} />
</Base>
