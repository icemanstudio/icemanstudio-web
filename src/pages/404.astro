---
import Base from '../layouts/Base.astro';
import { t as all } from '../data/t.js';
const t = all.en;
---
<Base t={t} title="404" path="/404">
  <section class="dead">
    <div>
      <h1>YOU DIED</h1>
      <p class="lead" style="text-align:center">The page you were looking for does not exist, or it respawned somewhere else.</p>
      <a class="btn" href="/">Respawn</a>
      <a class="btn ghost" href="/es/" style="margin-left:10px">Reaparecer</a>
    </div>
  </section>
</Base>
