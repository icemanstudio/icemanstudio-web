---
import Base from '../layouts/Base.astro';
import Legal from '../components/Legal.astro';
import { t as all } from '../data/t.js';
import { legal } from '../data/legal.js';
const t = all.en;
---
<Base t={t} title={legal.en.privacyTitle} path="/privacy/" description={legal.en.privacyTitle}>
  <Legal t={t} kind="privacy" />
</Base>
