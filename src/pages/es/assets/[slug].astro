---
import Base from '../../../layouts/Base.astro';
import ProductPage from '../../../components/ProductPage.astro';
import { products } from '../../../data/products.js';
import { t as all } from '../../../data/t.js';
import { productLd } from '../../../data/ld.js';
export function getStaticPaths() { return products.map((p) => ({ params: { slug: p.slug }, props: { p } })); }
const { p } = Astro.props;
const t = all.es;
---
<Base t={t} title={p.name} path={`/assets/${p.slug}/`} description={`${p.name}: ${p.short[t.lang]}`} image={p.cover} jsonld={productLd(p, t.lang)}>
  <ProductPage p={p} t={t} />
</Base>
