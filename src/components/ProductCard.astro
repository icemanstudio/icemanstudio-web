---
// Store card. Keeps `card product` + data-slug + .price-tags + .badge: public/offers.js and public/search.js rely on them.
import { priceInfo, fmt } from '../data/offers.js';
import { categories } from '../data/products.js';
const { p, t } = Astro.props;
const L = t.lang;
const pi = priceInfo(p);
const href = `${t.base}/assets/${p.slug}/`;
---
<a class="card product pcard" href={href} data-slug={p.slug} data-cat={p.cat} data-free={pi.free ? '1' : '0'}>
  <div class="media">
    {p.cover && <img src={p.cover} alt={p.name} loading="lazy" />}
    {pi.free ? <span class="badge free">{t.store.free}</span> : <span class="badge sale" hidden={!pi.offer}>{pi.offer ? `-${pi.offer.percent}%` : ''}</span>}
  </div>
  <div class="body">
    <span class="eyebrow">{categories[p.cat][L]}</span>
    <h3>{p.name}</h3>
    <p class="short">{p.short[L]}</p>
    <div class="foot">
      <div class="price-tags">
        {pi.free ? <b class="now">{t.store.free}</b> : pi.offer
          ? <><b class="now">{fmt(pi.final, L)}</b><s>{fmt(pi.base, L)}</s></>
          : <b class="now">{fmt(pi.base, L)}</b>}
      </div>
      <span class="go">{t.store.view} <span aria-hidden="true">→</span></span>
    </div>
  </div>
</a>
