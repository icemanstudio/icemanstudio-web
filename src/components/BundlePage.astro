---
import ProductCard from './ProductCard.astro';
import { bundleInfo } from '../data/bundles.js';
import { fmt } from '../data/offers.js';
import { config } from '../data/config.js';
const { b, t } = Astro.props;
const L = t.lang;
const s = t.store;
const bi = bundleInfo(b);
---
<nav class="crumbs small"><a href={`${t.base}/assets/`}>{s.title}</a> <span>/</span> <a href={`${t.base}/assets/#bundles`}>{s.bundles}</a> <span>/</span> <span class="muted">{b.name}</span></nav>
<section class="product-hero">
  <div class="bundle-covers big">
    {bi.items.map((p) => <a href={`${t.base}/assets/${p.slug}/`}><img src={p.cover} alt={p.name} loading="lazy" /></a>)}
  </div>
  <aside class="buybox" id="buy">
    <span class="eyebrow">{s.bundles} · {bi.items.length} {s.items}</span>
    <h1>{b.name}</h1>
    <p class="sub">{b.sub[L]}</p>
    <p class="muted">{b.short[L]}</p>
    <div class="price"><span class="big">{fmt(b.price, L)}</span> <s class="muted">{fmt(bi.sum, L)}</s> <span class="tag sale">-{bi.percent}%</span></div>
    <p class="small offer-note">{s.youSave} {fmt(bi.save, L)}</p>
    <div class="actions">
      {config.stripeEnabled
        ? <form method="post" action="/api/checkout" id="buy-form"><input type="hidden" name="bundle" value={b.slug} /><input type="hidden" name="lang" value={L} /><button class="btn big" type="submit">{s.buyBundle}</button></form>
        : <p class="small muted">{s.soonCheckout}</p>}
    </div>
    <ul class="perks">{s.perks.map((x) => <li>{x}</li>)}</ul>
    {config.stripeEnabled && <p class="small muted">{s.secure}</p>}
    <p class="small muted">{s.vat}</p>
  </aside>
</section>
<section>
  <div class="sec-head"><h2>{s.included}</h2></div>
  <div class="pgrid">{bi.items.map((p) => <ProductCard p={p} t={t} />)}</div>
</section>
{config.stripeEnabled && (
  <div class="buybar" aria-hidden="true">
    <div><b>{b.name}</b><div class="price-tags"><b class="now">{fmt(b.price, L)}</b><s>{fmt(bi.sum, L)}</s></div></div>
    <button class="btn" type="submit" form="buy-form" tabindex="-1">{s.buyBar}</button>
  </div>
)}
<script>
  const box = document.getElementById('buy'); const bar = document.querySelector('.buybar');
  if (box && bar && 'IntersectionObserver' in window) new IntersectionObserver(([e]) => bar.classList.toggle('show', !e.isIntersecting && e.boundingClientRect.top < 0)).observe(box);
</script>
