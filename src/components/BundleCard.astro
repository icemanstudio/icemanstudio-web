---
import { bundleInfo } from '../data/bundles.js';
import { fmt } from '../data/offers.js';
const { b, t, wide = false } = Astro.props;
const L = t.lang;
const bi = bundleInfo(b);
---
<a class={`card product pcard bundle${wide ? ' wide' : ''}`} href={`${t.base}/assets/bundle/${b.slug}/`} data-cat="bundle" data-free="0">
  <div class="media bundle-covers">
    {bi.items.slice(0, 4).map((p) => <img src={p.cover} alt={p.name} loading="lazy" />)}
    <span class="badge sale">-{bi.percent}%</span>
  </div>
  <div class="body">
    <span class="eyebrow">{t.store.bundles} · {bi.items.length} {t.store.items}</span>
    <h3>{b.name}</h3>
    <p class="short">{b.short[L]}</p>
    <p class="save">{t.store.youSave} {fmt(bi.save, L)}</p>
    <div class="foot">
      <div class="price-tags"><b class="now">{fmt(b.price, L)}</b><s>{fmt(bi.sum, L)}</s></div>
      <span class="go">{t.store.view} <span aria-hidden="true">→</span></span>
    </div>
  </div>
</a>
