---
import { faq, org } from '../data/geo.js';
const { t } = Astro.props;
const L = t.lang;
---
<section>
  <h2>{t.about.title}</h2>
  {t.about.text.map((x, i) => <p class={i === 0 ? "lead" : ""} style="margin:0 0 12px">{x}</p>)}
  <p style="margin-top:24px"><a class="btn" href={`${t.base}/assets`}>{t.about.cta}</a> <a class="btn ghost" href={`${t.base}/pixel-art`} style="margin-left:10px">{t.about.free}</a></p>
</section>

<section id="faq">
  <h2 style="font-size:26px">{t.about.faq}</h2>
  <div class="faq">
    {faq[L].map((f) => (
      <details class="card">
        <summary><strong>{f.q}</strong></summary>
        <p style="margin:10px 0 0">{f.a}</p>
      </details>
    ))}
  </div>
  <p class="small muted" style="margin-top:16px">{t.about.machine} <a href="/llms.txt">llms.txt</a> · <a href="/catalog.json">catalog.json</a> · <a href="/sitemap-index.xml">sitemap</a></p>
</section>
