---
import { faq, org } from '../data/geo.js';
const { t } = Astro.props;
const L = t.lang;
---
<section>
  <h2>{t.about.title}</h2>
  <p class="lead">{t.about.text}</p>
  <img src="/brand/logo-horizontal-dark.svg" alt="IceMan Studio" style="max-width:420px;width:100%;border-radius:6px;border:1px solid #2a2a2a" />
</section>

<section id="faq">
  <h2 style="font-size:26px">{t.about.faq}</h2>
  <div class="faq">
    {faq[L].map((f) => (
      <details class="card">
        <summary><strong>{f.q}</strong></summary>
        <p style="margin:10px 0 0">{f.a}</p>
      </details>
    ))}
  </div>
  <p class="small muted" style="margin-top:16px">{t.about.machine} <a href="/llms.txt">llms.txt</a> · <a href="/catalog.json">catalog.json</a> · <a href="/sitemap-index.xml">sitemap</a></p>
</section>
