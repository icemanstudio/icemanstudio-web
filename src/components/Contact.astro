---
const { t } = Astro.props;
const c = t.contact;
---
<section>
  <h2>{c.title}</h2>
  <p class="lead">{c.lead}</p>
  <form id="contact" method="post" action="/api/contact">
    <label>{c.name}<input name="name" required /></label>
    <label>{c.email}<input name="email" type="email" required /></label>
    <label>{c.topic}<select name="topic">{c.topics.map((x) => <option>{x}</option>)}</select></label>
    <label>{c.message}<textarea name="message" required></textarea></label>
    <input type="text" name="website" tabindex="-1" autocomplete="off" style="display:none" />
    <input type="hidden" name="lang" value={t.lang} />
    <div><button class="btn" type="submit">{c.send}</button></div>
  </form>
  <div class="result" id="ct-out" hidden></div>
</section>
<script define:vars={{ sent: c.sent, fail: c.fail }}>
  const form = document.getElementById('contact');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const out = document.getElementById('ct-out');
    try {
      const r = await fetch('/api/contact', { method: 'POST', body: new FormData(form) });
      out.textContent = r.ok ? sent : fail;
    } catch { out.textContent = fail; }
    out.hidden = false;
    if (out.textContent === sent) form.reset();
  });
</script>
