---
import '../styles/global.css';
import { org } from '../data/geo.js';
const { t, title, path = '', description, image, jsonld } = Astro.props;
const canonical = `https://icemanstudio.com${t.base}${path || '/'}`;
const desc = description || t.hero.sub;
const ogImage = image ? (image.startsWith('http') ? image : `https://icemanstudio.com${image}`) : 'https://icemanstudio.com/brand/logo-horizontal-dark.svg';
const orgLd = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Organization', '@id': `${org.url}/#org`, name: org.name, url: org.url, logo: org.logo, email: org.email, foundingDate: org.founded, address: { '@type': 'PostalAddress', addressCountry: org.country }, sameAs: org.sameAs, description: org.summary[t.lang] },
  { '@type': 'WebSite', '@id': `${org.url}/#site`, url: org.url, name: org.name, inLanguage: ['en', 'es'], publisher: { '@id': `${org.url}/#org` }, potentialAction: { '@type': 'SearchAction', target: { '@type': 'EntryPoint', urlTemplate: `${org.url}${t.base}/assets/?q={search_term_string}` }, 'query-input': 'required name=search_term_string' } }
] };
const b = t.base;
const otherBase = t.other === 'es' ? '/es' : '';
import pkg from '../../package.json';
import { activeOffers, offerUntil } from '../data/offers.js';
const offers = activeOffers();
const version = pkg.version;
const pageTitle = title ? `${title} · IceMan Studio` : 'IceMan Studio · Tools and assets for indie game developers';
---
<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="en" href={`https://icemanstudio.com${path}`} />
    <link rel="alternate" hreflang="es" href={`https://icemanstudio.com/es${path}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="IceMan Studio" />
    <meta property="og:locale" content={t.lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    <script src="/juice.js" defer></script>
    <script src="/search.js" defer></script>
    <script src="/offers.js" defer></script>
  </head>
  <body>
    <a class="offer-bar" id="offer-bar" href={`${b}/assets/`} hidden={offers.length === 0}>
      {offers.slice(0, 1).map((o) => <span><strong>{o.name[t.lang]} · -{o.percent}%</strong> · {t.store.ends} {offerUntil(o)}{o.code ? ` · ${t.store.code} ${o.code}` : ''} <u>{t.home.cta1} →</u></span>)}
    </a>
    <header class="site">
      <div class="wrap">
        <a class="logo" href={b || '/'} aria-label="IceMan Studio"><img src="/brand/logo-header.svg" alt="IceMan Studio" /></a>
        <form id="site-search" class="search" role="search" autocomplete="off">
          <input type="search" name="q" placeholder={t.search.placeholder} aria-label={t.search.placeholder} />
          <div class="results" hidden></div>
          <button type="button" class="menu-btn" id="menu-btn" aria-label="Menu" aria-expanded="false" aria-controls="site-nav"><span></span><span></span><span></span></button>
        </form>
        <nav id="site-nav">
          <a class="nav-store" href={`${b}/assets/`}>{t.nav.assets}</a>
          <a href={`${b}/pixel-art`}>{t.nav.pixel}</a>
          <a href={`${b}/tools`}>{t.nav.tools}</a>
          <a href={`${b}/about`}>{t.nav.about}</a>
          <a href={`${b}/contact`}>{t.nav.contact}</a>
          <a href={`${b}/account/`}>{t.nav.account}</a>
          <a class="lang" href={`${otherBase}${path || '/'}`}>{t.otherLabel}</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap foot-grid">
        <div class="foot-brand">
          <img src="/brand/logo-header.svg" alt="IceMan Studio" height="40" />
          <p class="muted">{t.foot.tagline}</p>
          <p class="small muted">{t.footer}</p>
        </div>
        <div><b>{t.foot.shop}</b>
          <a href={`${b}/assets/`}>{t.nav.assets}</a>
          <a href={`${b}/assets/#bundles`}>{t.store.bundles}</a>
          <a href={`${b}/assets/#free`}>{t.store.freeOnly}</a>
          <a href={`${b}/pixel-art`}>{t.nav.pixel}</a>
        </div>
        <div><b>{t.foot.studio}</b>
          <a href={`${b}/about`}>{t.nav.about}</a>
          <a href={`${b}/tools`}>{t.nav.tools}</a>
          <a href="https://icemaan.itch.io/">itch.io</a>
          <a href="https://github.com/icemanstudio">GitHub</a>
        </div>
        <div><b>{t.foot.help}</b>
          <a href={`${b}/contact`}>{t.nav.contact}</a>
          <a href={`${b}/account/`}>{t.nav.account}</a>
          <a href={`${b}/privacy/`}>{t.nav.privacy}</a>
          <a href={`${b}/terms/`}>{t.nav.terms}</a>
          <a href="https://github.com/icemanstudio/icemanstudio-web/commits/main" title="Patch notes">build v{version}</a>
        </div>
      </div>
    </footer>
  </body>
</html>
